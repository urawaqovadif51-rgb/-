# Magic Classroom AI Environment Template
# Copy this file to .env.local for local development.

# Application
NODE_ENV=development
APP_NAME=magic-classroom-ai
APP_URL=http://localhost:5173

# Frontend public settings
VITE_APP_NAME=Magic Classroom AI
VITE_API_BASE_URL=http://localhost:8000/api
VITE_ASSET_BASE_URL=

# Backend
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/magic_classroom

# Redis
REDIS_URL=redis://localhost:6379/0

# Object Storage
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# AI Provider
# Never expose production API keys to frontend.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Security
JWT_SECRET=
SESSION_SECRET=

# Logging
LOG_LEVEL=info
