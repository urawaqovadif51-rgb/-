{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://magic-classroom-ai.local/schemas/course.schema.json",
  "title": "Magic Classroom AI Course Schema",
  "type": "object",
  "required": ["schemaVersion", "course", "scenes"],
  "properties": {
    "schemaVersion": {"type": "string"},
    "course": {
      "type": "object",
      "required": ["id", "slug", "title", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "slug": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "title": {"type": "string", "minLength": 1},
        "subtitle": {"type": "string"},
        "locale": {"type": "string", "default": "zh-CN"},
        "status": {"enum": ["draft", "review", "published", "archived"]},
        "theme": {"type": "string"},
        "estimatedMinutes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": true
    },
    "theme": {"type": "object", "additionalProperties": true},
    "audio": {"type": "object", "additionalProperties": true},
    "teacher": {"type": "object", "additionalProperties": true},
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "order", "type", "title"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "order": {"type": "integer", "minimum": 1},
          "type": {
            "enum": ["intro", "map-explore", "timeline", "reading", "quiz", "matching", "ai-guide", "summary", "result"]
          },
          "title": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}